import core/option::{Option}
import std/env::{args_count, get_arg}
import std/io::{println}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener}
import std/task::{block_on}
import std/vec::{Vec}
import ./webhook::{ResponseHeader, load_hooks, parse_default_methods, parse_global_header, parse_port, serve_file_forever_async}

fn usage() {
    println("Usage: webhook --hooks <hooks.json> [--port <1-65535>] [--header name=value] [--http-methods GET,POST]")
}

pub fn main() -> i32 {
    auto hooks_path# = string::from("")
    auto port# = 9000:u16
    auto headers# = Vec<ResponseHeader>::new()
    auto default_methods# = Vec<string>::new()
    auto index# = 1:i32
    loop index < args_count() {
        auto argument = get_arg(index)
        if argument.as_str().equals("--hooks") {
            index = index + 1
            if index >= args_count() { usage(); return 2 }
            hooks_path = get_arg(index)
        } else if argument.as_str().equals("--port") {
            index = index + 1
            if index >= args_count() { usage(); return 2 }
            auto parsed = parse_port(get_arg(index).as_str())
            if parsed.is_err() { println("invalid --port"); return 2 }
            port = parsed.unwrap()
        } else if argument.as_str().equals("--header") {
            index = index + 1
            if index >= args_count() { usage(); return 2 }
            auto parsed = parse_global_header(get_arg(index).as_str())
            if parsed.is_err() { println("invalid header"); return 2 }
            headers#.push(cede parsed.unwrap())
        } else if argument.as_str().equals("--http-methods") {
            index = index + 1
            if index >= args_count() { usage(); return 2 }
            auto parsed = parse_default_methods(get_arg(index).as_str())
            if parsed.is_err() { println("invalid --http-methods"); return 2 }
            default_methods = cede parsed.unwrap()
        } else { usage(); return 2 }
        index = index + 1
    }
    if hooks_path.len() == 0:usize { usage(); return 2 }
    auto checked = load_hooks(hooks_path.clone())
    if checked.is_err() { println("failed to load hooks JSON"); return 1 }

    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(0:u8, 0:u8, 0:u8, 0:u8), port))
    if !listener.is_valid() { println("failed to bind listener"); return 1 }
    auto server = serve_file_forever_async(cede hooks_path, cede listener, cede headers, cede default_methods, 1048576:usize, 30000:i32).start
    return block_on<i32>(server)
}
