[
  {
    "id": "deploy",
    "execute-command": "/usr/bin/true",
    "response-message": "deployment accepted",
    "success-http-response-code": 202,
    "trigger-rule-mismatch-http-response-code": 403,
    "response-headers": [
      {"name": "X-Webhook-Response", "value": "configured"}
    ],
    "pass-arguments-to-command": [],
    "trigger-rule": {
      "match": {
        "value": "correct-horse",
        "parameter": {
          "source": "header",
          "name": "X-Hook-Secret"
        }
      }
    }
  }
  ,
  {
    "id": "env",
    "execute-command": "/usr/bin/printenv",
    "pass-arguments-to-command": ["WEBHOOK_TEST"],
    "include-command-output-in-response": true,
    "pass-environment-to-command": [
      {"source": "string", "name": "webhook", "envname": "WEBHOOK_TEST"}
    ],
    "trigger-rule": {
      "match": {
        "value": "correct-horse",
        "parameter": {
          "source": "header",
          "name": "X-Hook-Secret"
        }
      }
    }
  },
  {
    "id": "query",
    "execute-command": "/usr/bin/printf",
    "pass-arguments-to-command": [
      {"source": "string", "name": "%s"},
      {"source": "url", "name": "message"}
    ],
    "include-command-output-in-response": true,
    "trigger-rule": {
      "match": {
        "value": "correct-horse",
        "parameter": {
          "source": "header",
          "name": "X-Hook-Secret"
        }
      }
    }
  },
  {
    "id": "references",
    "execute-command": "/usr/bin/printf",
    "pass-arguments-to-command": [
      {"source": "string", "name": "%s|%s|%s"},
      {"source": "header", "name": "X-Trace"},
      {"source": "raw-request-body"},
      {"source": "request", "name": "method"}
    ],
    "include-command-output-in-response": true,
    "trigger-rule": {
      "match": {
        "value": "correct-horse",
        "parameter": {
          "source": "header",
          "name": "X-Hook-Secret"
        }
      }
    }
  },
  {
    "id": "payload",
    "execute-command": "/usr/bin/printf",
    "pass-arguments-to-command": [
      {"source": "string", "name": "%s"},
      {"source": "payload", "name": "repository.name"}
    ],
    "include-command-output-in-response": true,
    "trigger-rule": {
      "match": {
        "value": "correct-horse",
        "parameter": {
          "source": "header",
          "name": "X-Hook-Secret"
        }
      }
    }
  }
]
